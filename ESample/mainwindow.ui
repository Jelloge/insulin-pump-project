    <property name="styleSheet">
     <string notr="true">
QPlainTextEdit {
    background-color: #424242; /* Dark background */
    color: white; /* White text */
    border: 1px #5F6368; /* Very thin border */
    border-radius: 4px; /* Rounded corners */
    padding: 8px;
    font-size: 14px; /* Font size for text */
}
/* Style for QStackedWidget */
QStackedWidget {
    background-color: #2E2E2E; /* Dark gray background */
}

/* Style for QPushButton */
QPushButton {
    background-color: #5F6368; /* Subtle blue-gray */
    color: white;
    border: 2px solid #3A3F44; /* Darker gray border */
    border-radius: 8px; /* Rounded corners */
    padding: 8px 16px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #3A3F44; /* Slightly darker gray on hover */
}

QPushButton:pressed {
    background-color: #2C3136; /* Darker gray when pressed */
}

/* Style for QLabel */
QLabel {
    color: #00B0FF; /* Light ocean blue color for text */
    font-size: 16px; /* Slightly larger text */
    font-weight: bold; /* Bold text for emphasis */
}

/* Style for QCheckBox */
QCheckBox {
    color: white; /* White text for the checkbox label */
    font-size: 14px; /* Slightly smaller font size */
    padding: 5px;
    border: 2px solid #3A3F44; /* Dark gray border around the checkbox */
    border-radius: 4px; /* Rounded corners for checkbox */
    padding-left: 10px;
}

QCheckBox:hover {
    border-color: #5F6368; /* Subtle hover effect with a lighter gray border */
}

QCheckBox::indicator:checked {
    background-color: #00b0f0; /* Light Ocean Blue or your desired background color */
   
    border-radius: 4px;
}

QCheckBox::indicator:checked:pressed {
    background-color: #008CBA; /* Slightly darker blue when pressed */
}

/* Style for QLineEdit (e.g., text input fields) */
QLineEdit {
    background-color: #424242; /* Dark background */
    color: white; /* White text */
    border: 2px solid #3A3F44; /* Border around the text field */
    border-radius: 4px; /* Rounded corners */
    padding: 6px 10px;
}

QLineEdit:focus {
    border-color: #5F6368; /* Highlight the border when focused */
}

/* Style for QComboBox (e.g., dropdowns) */
QComboBox {
    background-color: #424242; /* Dark background */
    color: white; /* White text */
    border: 2px solid #3A3F44; /* Border color */
    border-radius: 4px;
    padding: 6px;
}

QComboBox:hover {
    border-color: #5F6368; /* Highlight border color on hover */
}

QComboBox:focus {
    border-color: #5F6368; /* Highlight border color when focused */
}

/* Style for QRadioButton */
QRadioButton {
    color: white; /* White text */
    font-size: 14px; /* Text size */
    padding: 5px;
    border: 2px solid #3A3F44; /* Dark gray border */
    border-radius: 4px; /* Rounded corners */
}

QRadioButton:hover {
    border-color: #5F6368; /* Hover effect */
}

QRadioButton:checked {
    background-color: #3A3F44; /* Dark gray when checked */
    color: #B0BEC5; /* Lighter text when checked */
}
</string>
